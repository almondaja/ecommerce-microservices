# Isi di Render Dashboard > Environment. Jangan commit nilai secret sebenarnya.
JWT_SECRET=buat-secret-acak-minimal-64-karakter
INTERNAL_SERVICE_TOKEN=buat-token-internal-acak-minimal-64-karakter
CORS_ORIGIN=https://nama-aplikasi-kamu.vercel.app

# Neon: gunakan hostname dari connection details (disarankan pooled hostname).
NEON_DB_HOST=ep-xxxx-pooler.region.aws.neon.tech
NEON_DB_PORT=5432
NEON_DB_USER=neondb_owner
NEON_DB_PASSWORD=password-dari-neon
DB_POOL_MAX=3

USER_DB_NAME=ecommerce_user_db
PRODUCT_DB_NAME=ecommerce_product_db
ORDER_DB_NAME=ecommerce_order_db
PAYMENT_DB_NAME=ecommerce_payment_db

# URL AMQPS dari CloudAMQP free (Loyal Lemming/shared LavinMQ per Nov 2026).
AMQP_URL=amqps://username:password@host/vhost
