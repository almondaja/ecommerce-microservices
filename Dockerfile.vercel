# Vercel Container Runtime entrypoint for the demo backend.
# The API Gateway is public; the four internal services bind to localhost.
FROM node:22-alpine

WORKDIR /app

COPY user-service/package*.json ./user-service/
RUN npm --prefix user-service install --omit=dev --no-audit --no-fund

COPY product-service/package*.json ./product-service/
RUN npm --prefix product-service install --omit=dev --no-audit --no-fund

COPY order-service/package*.json ./order-service/
RUN npm --prefix order-service install --omit=dev --no-audit --no-fund

COPY payment-service/package*.json ./payment-service/
RUN npm --prefix payment-service install --omit=dev --no-audit --no-fund

COPY api-gateway/package*.json ./api-gateway/
RUN npm --prefix api-gateway install --omit=dev --no-audit --no-fund

COPY user-service ./user-service
COPY product-service ./product-service
COPY order-service ./order-service
COPY payment-service ./payment-service
COPY api-gateway ./api-gateway
COPY deploy/start-all.js ./deploy/start-all.js

ENV NODE_ENV=production
ENV PORT=80
EXPOSE 80

CMD ["node", "deploy/start-all.js"]
