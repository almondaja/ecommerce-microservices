# Copy to .env before running: cp .env.example .env
# Development values only. Change every password/token before deployment.

JWT_SECRET=change-this-to-a-long-random-secret
INTERNAL_SERVICE_TOKEN=change-this-to-another-long-random-token
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8080

USER_DB_USER=ecommerce_user
USER_DB_PASSWORD=change-user-db-password
USER_DB_NAME=ecommerce_user_db
USER_DB_PORT=5433

PRODUCT_DB_USER=ecommerce_product
PRODUCT_DB_PASSWORD=change-product-db-password
PRODUCT_DB_NAME=ecommerce_product_db
PRODUCT_DB_PORT=5434

ORDER_DB_USER=ecommerce_order
ORDER_DB_PASSWORD=change-order-db-password
ORDER_DB_NAME=ecommerce_order_db
ORDER_DB_PORT=5435

PAYMENT_DB_USER=ecommerce_payment
PAYMENT_DB_PASSWORD=change-payment-db-password
PAYMENT_DB_NAME=ecommerce_payment_db
PAYMENT_DB_PORT=5436
